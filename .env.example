# PostgreSQL 접속 정보 (로컬 개발은 Docker Postgres 등을 사용하세요)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/overcook?schema=public"

# 관리자 세션 쿠키 서명에 사용되는 32자 이상의 무작위 문자열
# 생성 예시: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-random-32-byte-string"

# 고객 이름/연락처 등 개인정보 필드를 AES-256-GCM으로 암호화하는 데 쓰는 키(32자 이상).
# 생성 예시: openssl rand -hex 32 — 절대 노출/변경하지 마세요 — 바뀌면 기존에
# 암호화된 데이터를 복호화할 수 없게 됩니다.
FIELD_ENCRYPTION_KEY="change-this-to-a-random-32-byte-string"

# 이메일 알림 — https://resend.com
RESEND_API_KEY=""
ADMIN_NOTIFY_EMAIL="hello@example.com"
# 발신 주소. Resend 에서 도메인(movd.co.kr)을 인증(SPF·DKIM DNS 추가)한 뒤에 설정하세요.
# 비워 두면 Resend 샌드박스 발신자로 폴백 — 관리자 본인 이메일로만 발송됩니다.
RESEND_FROM=""   # 예: "MOVD <notify@movd.co.kr>"

# Slack 실시간 알림 (계약 서명, 입금 알림, 새 채팅 메시지, 일일 방문 리포트) — Slack 앱 푸시로 폰에서 바로 받기.
# Slack 워크스페이스 > Apps > "Incoming Webhooks" 추가 > 채널 선택 > 발급되는 URL을 그대로 붙여넣기.
# 비워두면 Slack 알림은 건너뜁니다(이메일 알림은 그대로 동작).
SLACK_WEBHOOK_URL=""

# 크론 엔드포인트용 공유 시크릿. openssl rand -hex 32 로 생성. 설정하면 아래 두
# 엔드포인트는 Authorization: Bearer <시크릿> 이 있어야만 호출됩니다.
#
# 1) 일일 방문 리포트 — 전날 방문 요약을 슬랙으로:
#   0 15 * * * curl -sf -H "Authorization: Bearer $CRON_SECRET" https://<도메인>/api/cron/daily-report  (15:00 UTC = 한국시간 자정)
# 2) 업로드 정리 — DB 어디에서도 안 쓰는 public/uploads 파일(관리자가 올렸다 뺀 이미지 등) 삭제:
#   30 4 * * * curl -sf -H "Authorization: Bearer $CRON_SECRET" https://<도메인>/api/cron/sweep-uploads
#   (처음엔 ?dryRun=1 을 붙여 무엇이 지워질지 먼저 확인 가능)
#   3) 블로그 자동 발행 — Gemini 가 주제 선정 → 초안 생성 → 티스토리 발행 대기열 등록
#      (실제 게시는 로컬 퍼블리셔). 하루 1회:
#      0 0 * * * curl -sf -H "Authorization: Bearer $CRON_SECRET" https://<도메인>/api/cron/blog-auto
CRON_SECRET=""

# 채널별 웹훅 — 비우면 전부 SLACK_WEBHOOK_URL 로 갑니다.
# 기본(SLACK_WEBHOOK_URL) = 계약 서명 알림.
SLACK_WEBHOOK_URL_REPORT=""   # 일일 방문 리포트 (예: #데일리보고서)
SLACK_WEBHOOK_URL_PAYMENT=""  # 입금·결제 알림 (예: #결제알림)
SLACK_WEBHOOK_URL_CHAT=""     # 새 채팅 메시지 (예: #채팅알림)

# 텔레그램 봇 알림 (Slack 과 병행 — 둘 중 하나만 넣어도 됩니다).
# 1) 텔레그램에서 @BotFather 에게 /newbot → 봇 이름 정하면 토큰이 나옵니다.
# 2) 만든 봇과 1:1 대화를 열어 아무 메시지나 한 번 보냅니다.
# 3) https://api.telegram.org/bot<토큰>/getUpdates 를 열어
#    result[0].message.chat.id 값을 TELEGRAM_CHAT_ID 에 넣습니다.
# 비워두면 텔레그램 알림은 건너뜁니다.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# 디스코드 웹훅 알림 (Slack/텔레그램과 병행). 서버 설정 > 연동 > 웹후크 > 새 웹후크 >
# 채널 선택 > URL 복사. 비우면 건너뜁니다. 새 채팅·결제·블로그 발행 실패 알림이 갑니다.
DISCORD_WEBHOOK_URL=""

# 고객 SMS (Solapi) — 관리자가 채팅에 답장하면 고객에게 "새 답변 도착" 문자 1건(디바운스).
# solapi.com 가입 > API Key/Secret 발급 > 발신번호 등록(본인인증). 셋 다 있어야 동작.
SOLAPI_API_KEY=""
SOLAPI_API_SECRET=""
SMS_SENDER=""   # 등록한 발신번호, 예: 01012345678

# 백업 아카이브 암호화 암호구절(gpg 대칭키). 설정하면 /opt/pg-backup.sh 가 DB 덤프 +
# .env 를 이 암호로 암호화합니다. 이 값 자체는 1Password 등 별도 안전한 곳에 보관하세요
# (백업 안에 넣으면 의미 없음). 미설정 시 아카이브에 .env 가 평문으로 들어갑니다.
BACKUP_PASSPHRASE=""

# 블로그 글 초안 생성 (/admin/blog) · 견적 작업분해 (/admin/estimate) — Google Gemini API.
# aistudio.google.com/apikey 에서 무료 키 발급. 없으면 초안 생성 버튼이 에러를 냅니다(앱은 정상).
GEMINI_API_KEY=""
# 선택 — 기본 gemini-3.6-flash. 더 좋은 글은 gemini-3.6-pro.
BLOG_DRAFT_MODEL=""

# 블로그 자동 발행 — 로컬 퍼블리셔(tools/blog-publisher)가 /api/publish/* 를 호출할 때
# 쓰는 공유 시크릿. openssl rand -hex 32. 비우면 발행 대기열 API 가 비활성(404).
PUBLISHER_SECRET=""

# 레이트리밋 (Upstash Redis) — https://upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# 사이트 절대 URL. 이메일 링크·세션 쿠키 https 판별에 쓰이고, 프로덕션에서는
# 사이트맵·robots·OG 태그·JSON-LD 구조화 데이터의 canonical URL이 됩니다.
# 배포 시 실제 도메인으로 반드시 교체하세요 (끝에 / 없이). 미설정 시 코드 폴백은
# src/lib/site.ts 의 FALLBACK 값입니다.
SITE_URL="http://localhost:3000"

# 검색엔진 사이트 소유 확인 코드 — 각 콘솔에서 사이트 등록 후 발급되는 코드를
# 그대로 넣으면 됩니다. 비워두면 해당 meta 태그가 생성되지 않습니다.
# 구글: https://search.google.com/search-console
# 네이버: https://searchadvisor.naver.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=""
