generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- 관리자 ----------

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  orders             Order[]             @relation("OrderCreatedBy")
  refunds            Refund[]
  auditLogs          AuditLog[]
  manualLedgerEntries ManualLedgerEntry[] @relation("ManualLedgerCreatedBy")
}

// ---------- 고객 계정 ----------

model Customer {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  phone        String?
  createdAt    DateTime @default(now())

  orders            Order[]
  inquiries         Inquiry[]
  chatConversations ChatConversation[]
}

// ---------- 문의 ----------

enum InquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

model Inquiry {
  id         String        @id @default(cuid())
  name       String
  company    String?
  email      String
  phone      String?
  budget     String?
  message    String
  status     InquiryStatus @default(NEW)
  customerId String?
  customer   Customer?     @relation(fields: [customerId], references: [id])
  createdAt  DateTime      @default(now())

  @@index([createdAt])
  @@index([status])
}

// ---------- 포트폴리오 ----------

model PortfolioItem {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  category    String
  summary     String
  body        String    @default("")
  tags        String[]  @default([])
  images      String[]  @default([])
  // 케이스 스터디 카드에 표시하는 요약 정보 — 전부 선택 입력이라 비워두면
  // 해당 항목만 카드에서 자연스럽게 빠집니다.
  industry    String? // 업종, 예: "이커머스"
  features    String[]  @default([]) // 기능, 예: ["카카오 챗봇", "결제 연동"]
  duration    String? // 기간, 예: "3주"
  cost        String? // 비용, 예: "300만원" · "비공개"
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ---------- 고객 후기 ----------

model Review {
  id          String    @id @default(cuid())
  // 회사명/작성자 표시 — 고객이 직접 제출하는 경우 실명·실제 소속을 그대로
  // 끌어오지 않고, 이 값도 고객이 익명성을 지키고 싶은 만큼 직접 입력합니다.
  company     String
  role        String?
  quote       String
  // 1~5 실제 평점 — 관리자가 직접 입력했거나 고객이 제출한 경우에만 채워집니다.
  // 지어낸 값을 넣지 않기 위해 선택 필드로 두고, 없으면 별점/AggregateRating
  // 계산에서 제외합니다.
  rating      Int?
  order       Int       @default(0) // 노출 순서, 작을수록 먼저 표시
  // 고객이 직접 제출한 후기면 어느 프로젝트인지 연결됩니다(프로젝트당 최대
  // 1개). 관리자가 직접 등록한 후기는 이 값이 없습니다 — publishedAt과
  // 별개로, orderId 유무로 "고객 제출 vs 관리자 등록"을 구분합니다.
  orderId     String?   @unique
  linkedOrder Order?    @relation(fields: [orderId], references: [id])
  // 관리자가 확인 후 게시 버튼을 눌러야만 공개됩니다 — 고객이 제출한 순간
  // 바로 사이트에 뜨지 않습니다(스팸/부적절한 내용 필터링).
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([publishedAt, order])
}

// 은행명/계좌번호/사업자 정보처럼 자주 바뀌진 않지만 대표님이 코드 수정 없이
// 직접 바꿀 수 있어야 하는 값들 — 항상 id="singleton" 한 행만 존재합니다.
model BusinessSettings {
  id                 String   @id @default("singleton")
  businessName       String   @default("Daisy")
  representativeName String   @default("")
  businessRegNo      String   @default("")
  mailOrderRegNo     String   @default("")
  address            String   @default("")
  phone              String   @default("")
  contactEmail       String   @default("hello@overcook.kr")
  // 자유 텍스트 — "평일 10:00~18:00 (주말·공휴일 휴무)"처럼 관리자가 그대로
  // 입력한 문구를 Footer·문의 페이지에 그대로 보여줍니다. 요일/시간을 구조화된
  // 필드로 나누지 않은 이유는, 실제 서비스 형태(상담 채팅 기반)라 "정확한 영업
  // 시간에 따라 시스템이 동작을 바꿔야 하는" 요구가 없고 표시 용도뿐이기 때문입니다.
  businessHours      String   @default("")
  bankName           String   @default("")
  bankAccountNumber  String   @default("")
  bankAccountHolder  String   @default("")
  updatedAt          DateTime @updatedAt
}

// 사이트 진입 시 뜨는 이벤트 팝업 — 대표님이 문구만 입력하면(이미지 제작 없이)
// 저희가 HTML로 디자인해서 보여줍니다. 여러 개를 동시에 켜두면 팝업 안에서
// 점(dot) 페이지네이션으로 슬라이드됩니다.
model Event {
  id          String   @id @default(cuid())
  enabled     Boolean  @default(true)
  order       Int      @default(0) // 노출 순서, 작을수록 먼저 표시
  badge       String   @default("") // 원형 배지에 들어가는 짧은 텍스트, 예: "20%"
  style       String   @default("dark") // "dark" | "light" | "festive" — 카드 디자인 톤
  title       String   @default("")
  description String   @default("")
  imageUrl    String   @default("") // 비어있지 않으면 문구 대신 이 이미지를 그대로 보여줌
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, order])
}

// ---------- 주문 / 결제 ----------

enum OrderStatus {
  DRAFT
  PENDING
  PAYMENT_CLAIMED // 고객이 "입금 완료" 버튼을 눌러 알려왔지만, 관리자가 실제 입금을 아직 확인 전
  PAID
  PARTIAL
  EXPIRED
  CANCELLED
  REFUNDED
}

// 결제 상태(OrderStatus)와는 별개로, 실제 작업 진행 단계를 고객에게 보여주기 위한 축입니다.
// 결제 완료(OrderStatus.PAID) 시점에 자동으로 RECEIVED로 전환됩니다.
enum ProjectStage {
  RECEIVED // 작업 시작
  IN_PROGRESS // 작업 중
  DELIVERED // 작업물 전달완료
}

model Order {
  id             String            @id @default(cuid())
  orderToken     String            @unique @default(cuid()) // 결제 링크에 노출되는 예측 불가능한 토큰
  invoiceNumber  String            @unique // 사람이 읽는 순번, 예: OC-2026-0001
  title          String
  description    String?
  amount         Int // KRW, 원 단위 정수
  // 견적서에 표시할 품목별 내역 — [{ label: string, amount: number }][]. 각 항목의
  // amount 합계는 항상 amount(총액)와 정확히 일치해야 합니다(생성 시 나머지를
  // 마지막 항목들에 배분해서 맞춤).
  lineItems      Json?
  currency       String            @default("KRW")
  status         OrderStatus       @default(DRAFT)
  progressStage  ProjectStage      @default(RECEIVED)
  customerName   String
  customerEmail  String
  customerPhone  String?
  businessRegNo  String?
  // 고객이 결제 페이지에서 "입금 완료했어요"를 누를 때 입력하는, 실제 이체 시
  // 사용한 이름 — 통장에 찍히는 입금자명과 주문자 정보가 다를 수 있어 관리자가
  // 입금 내역과 대조할 때 씁니다.
  depositorName  String?
  expiresAt      DateTime?
  createdById    String?
  createdBy      AdminUser?        @relation("OrderCreatedBy", fields: [createdById], references: [id])
  customerId     String?
  customer       Customer?         @relation(fields: [customerId], references: [id])
  // 채팅 안에서 발행된 결제 요청이면, 어느 대화(=어느 프로젝트)에서 만들어졌는지
  // 기록해 둡니다 — 나중에 결제/진행상황 알림을 그 대화로 정확히 보내기 위함입니다.
  conversationId String?
  conversation   ChatConversation? @relation(fields: [conversationId], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  payments     Payment[]
  chatMessages ChatMessage[]
  // 프로젝트당 후기는 하나만 — 이미 남겼으면 다시 못 남기게 하는 제약을
  // 애플리케이션 코드가 아니라 DB 차원에서도 보장합니다.
  review       Review?

  @@index([status])
  @@index([customerEmail])
}

enum PaymentStatus {
  READY
  PAID
  FAILED
  CANCELLED
  PARTIAL_CANCELLED
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id])
  paymentId   String        @unique // 포트원 결제 건 ID
  pgProvider  String        @default("portone")
  method      String?
  status      PaymentStatus @default(READY)
  amount      Int
  currency    String        @default("KRW")
  approvedAt  DateTime?
  rawResponse Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // 가상계좌 결제수단일 때만 채워짐 — 입금 안내 화면에 그대로 표시
  virtualAccountBank      String?
  virtualAccountNumber    String?
  virtualAccountHolder    String?
  virtualAccountExpiredAt DateTime?

  refunds Refund[]

  @@index([orderId])
  @@index([status])
}

model Refund {
  id          String     @id @default(cuid())
  paymentId   String
  payment     Payment    @relation(fields: [paymentId], references: [id])
  amount      Int
  reason      String
  pgCancelId  String?
  adminId     String?
  admin       AdminUser? @relation(fields: [adminId], references: [id])
  cancelledAt DateTime   @default(now())
}

// 포트원 웹훅 원본 로그 — 서명 검증 및 재처리 방지(idempotency)에 사용
model WebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  provider    String    @default("portone")
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
}

// 관리자 채팅 빠른 답변 템플릿 — 팀 전체가 공유
model QuickReply {
  id        String   @id @default(cuid())
  label     String
  body      String
  order     Int      @default(0) // 표시 순서, 작을수록 먼저 표시
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

// ---------- 장부 수동 입력 ----------
// 사이트 결제 흐름을 거치지 않고 받은 대금(계좌로 직접 입금, 오프라인 협의 건 등)을
// 장부에 직접 적어 넣기 위한 항목입니다. 자동 집계되는 Payment/Refund 와 합쳐서 보여줍니다.
enum LedgerKind {
  REVENUE // 결제(수입)
  REFUND // 환불
}

model ManualLedgerEntry {
  id            String     @id @default(cuid())
  occurredAt    DateTime // 실제로 돈이 오간 날
  kind          LedgerKind @default(REVENUE)
  title         String // 외주 프로젝트명
  detail        String? // 상세 기능
  customerName  String
  amount        Int // KRW, 항상 양수 (부호는 kind 로 결정)
  businessRegNo String?
  phone         String?
  memo          String? // 비고
  createdById   String?
  createdBy     AdminUser? @relation("ManualLedgerCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([occurredAt])
}

model AuditLog {
  id         String     @id @default(cuid())
  adminId    String?
  admin      AdminUser? @relation(fields: [adminId], references: [id])
  action     String // 예: "order.refund", "order.status_override"
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime   @default(now())

  @@index([targetType, targetId])
}

// ---------- 실시간 채팅 (로그인한 고객 계정에만 연결) ----------
// 채팅은 로그인한 고객만 이용할 수 있습니다 — 그래서 "익명 방문자" 대화가
// 존재하지 않고, 관리자는 항상 어떤 고객과 대화 중인지 알 수 있습니다.
// 고객 한 명이 프로젝트별로 여러 대화를 가질 수 있습니다(1:N) — 예전에는
// 고객당 대화가 정확히 1개로 고정돼 있었는데, 여러 프로젝트를 동시에 진행하면
// 서로 다른 프로젝트 얘기가 한 대화에 다 섞이는 문제가 있어 분리했습니다.

enum ChatConversationStatus {
  OPEN
  CLOSED
}

enum ChatSender {
  VISITOR // 고객(로그인한 Customer) 쪽에서 보낸 메시지
  ADMIN
}

enum ChatMessageType {
  TEXT
  PAYMENT_REQUEST
  PROGRESS_UPDATE
  ATTACHMENT
}

model ChatConversation {
  id            String                 @id @default(cuid())
  customerId    String
  customer      Customer               @relation(fields: [customerId], references: [id])
  title         String? // 예: "챗봇 개발 프로젝트" — 비어 있으면 "일반 문의"로 표시
  status        ChatConversationStatus @default(OPEN)
  lastMessageAt DateTime               @default(now())
  createdAt     DateTime               @default(now())

  messages ChatMessage[]
  orders   Order[]

  @@index([customerId, lastMessageAt])
  @@index([status, lastMessageAt])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id])
  sender         ChatSender
  type           ChatMessageType  @default(TEXT)
  body           String
  orderId        String? // type이 PAYMENT_REQUEST/PROGRESS_UPDATE일 때만 존재 — 채팅 안에 카드로 표시
  order          Order?           @relation(fields: [orderId], references: [id])
  attachmentUrl  String? // type이 ATTACHMENT일 때만 존재
  attachmentName String?
  attachmentMime String?
  read           Boolean          @default(false) // 상대방이 이 메시지를 읽었는지 여부
  createdAt      DateTime         @default(now())
  // read가 나중에 true로 바뀌는 시점을 감지하기 위한 필드 — 폴링 때 "새로 생긴
  // 메시지"뿐 아니라 "방금 읽음 처리된 내 메시지"도 다시 내려보내 읽음 표시가
  // 실시간으로 갱신되게 합니다.
  updatedAt      DateTime         @default(now()) @updatedAt

  @@index([conversationId, createdAt])
}

// ---------- 방문/이탈 분석 (자체 수집, 익명 세션 기반) ----------

enum AnalyticsEventType {
  PAGE_VIEW
  CONTACT_STARTED
  CONTACT_SUBMITTED
  CHECKOUT_STARTED
  CHECKOUT_COMPLETED
}

model AnalyticsEvent {
  id        String             @id @default(cuid())
  sessionId String // 쿠키 기반 익명 세션 ID (개인정보 아님)
  type      AnalyticsEventType
  path      String
  referrer  String?
  createdAt DateTime           @default(now())

  @@index([sessionId, createdAt])
  @@index([type, createdAt])
  @@index([path])
}
