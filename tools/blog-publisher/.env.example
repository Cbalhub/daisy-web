# MOVD 블로그 퍼블리셔 설정 — 이 파일을 .env 로 복사해서 채우세요.

# movd 앱 주소 (끝 슬래시 없이)
MOVD_API=https://movd.co.kr

# 앱 /opt/movd/.env 의 PUBLISHER_SECRET 과 똑같은 값
PUBLISHER_SECRET=

# 폴링 간격(ms). 기본 5분. --once 로 실행하면 1회만 처리.
POLL_INTERVAL_MS=300000

# 네이버 블로그 MCP 실행 명령 (space-cap/naver-blog-mcp 를 clone 후)
# 네이버 ID/PW 는 그 repo 의 .env 에 넣습니다. 가정용 IP 필수.
NAVER_MCP_CMD=uv --directory C:/dev/naver-blog-mcp run naver-blog-mcp

# 티스토리 MCP 실행 명령
TISTORY_MCP_CMD=npx -y kim-se-hee-tistory-mcp
