# MOVD 블로그 퍼블리셔 설정 — 이 파일을 .env 로 복사해서 채우세요.

# movd 앱 주소 (끝 슬래시 없이)
MOVD_API=https://movd.co.kr

# 앱 /opt/movd/.env 의 PUBLISHER_SECRET 과 똑같은 값
PUBLISHER_SECRET=

# 폴링 간격(ms). 기본 5분. --once 로 실행하면 1회만 처리.
POLL_INTERVAL_MS=300000

# ── 네이버 블로그 ──────────────────────────────────────────────
# space-cap/naver-blog-mcp 를 clone 한 경로. 네이버 ID/PW 는 그 repo 의 .env 에.
# 가정용 IP 필수. 처음엔 HEADLESS=false 로 두고 수동 로그인(캡차/2FA) → 세션 저장됨.
NAVER_MCP_CMD=uv --directory C:/movd-tools/naver-blog-mcp run naver-blog-mcp

# ── 티스토리 ──────────────────────────────────────────────────
# tistory-mcp 는 이 패키지 의존성으로 설치됨(npm install). 카카오 OAuth 로그인.
TISTORY_MCP_CMD=node node_modules/tistory-mcp/dist/index.js
# 발행 대상 블로그 host — 조용한 폴백이 막혀 있어 필수. 예: movdlog.tistory.com
TISTORY_BLOG_URL=
